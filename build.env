# Shared build settings for every stage and device.
# Keep this file free of secrets: it is hashed into the profiler cache key.

# --- kernel source ---------------------------------------------------------
# Pinned to a commit, not a branch: AutoFDO requires the profiling kernel and
# the optimized kernel to be built from the same source.
KERNEL_SOURCE=https://github.com/mt6768-S/android_kernel_xiaomi_mt6768.git
# eternal-l24, carries CONFIG_PROPELLER_CLANG / SPE profiler helpers
KERNEL_SOURCE_BRANCH=a04295a3a7af06a3c9a82d60c2a1ae0d9324be25
KERNEL_ARCH=arm64
KERNEL_IMAGE_NAME=Image.gz-dtb

# Devices built by CI. Each one maps to
# arch/arm64/configs/vendor/<device>.config in the kernel tree.
DEVICES=merlin lancelot selene

# --- configuration ---------------------------------------------------------
# 4.19 vendor layout: one SoC defconfig + a per-device fragment.
KERNEL_CONFIG_BASE=vendor/mt6768_defconfig
KERNEL_CONFIG_FRAGMENT_DIR=vendor
LOCALVERSION_SUFFIX=xxksu

# --- toolchain -------------------------------------------------------------
CLANG_SOURCE=https://github.com/Neutron-Toolchains/clang-build-catalogue/releases/download/06092026/neutron-clang-06092026.tar.zst
ENABLE_CCACHE=true
EXTRA_CMDS=LLVM=1 LLVM_IAS=1 CROSS_COMPILE=aarch64-linux-gnu- CROSS_COMPILE_ARM32=arm-linux-gnueabi- CROSS_COMPILE_COMPAT=arm-linux-gnueabi- CONFIG_NO_ERROR_ON_MISMATCH=y TARGET_BUILD_VARIANT=user

# --- stage behaviour -------------------------------------------------------
# Applied by build.sh only in the profiler stage. Set to false if your tree
# already carries the arm,statistical-profiling-extension-v1 node.
APPLY_SPE_PATCH=true

# --- root solution ---------------------------------------------------------
# SukiSU Ultra (xxksu), master branch. The setup script is executable and
# writes drivers/kernelsu + Kconfig hooks into the kernel tree.
ENABLE_KERNELSU=true
KERNELSU_SETUP_SOURCE=https://raw.githubusercontent.com/SukiSU-Ultra/SukiSU-Ultra/main/kernel/setup.sh
KERNELSU_TAG=main

# --- NoMount ---------------------------------------------------------------
ENABLE_NOMOUNT=true
NOMOUNT_SETUP_SOURCE=https://raw.githubusercontent.com/maxsteeel/nomount/refs/heads/dev/kernel/setup.sh
NOMOUNT_TAG=master

# --- packaging -------------------------------------------------------------
USE_ANYKERNEL3=true
ANYKERNEL3_SOURCE=https://github.com/mt6768-S/AnyKernel3.git
ANYKERNEL3_BRANCH=master

# --- AutoFDO tooling -------------------------------------------------------
# Prebuilt create_llvm_prof used when perf.data is committed instead of .afdo.
CREATE_LLVM_PROF_VERSION=v0.30.1
